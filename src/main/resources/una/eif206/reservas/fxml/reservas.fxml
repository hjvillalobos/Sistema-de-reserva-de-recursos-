<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" prefWidth="1000.0" prefHeight="820.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.eif206.reservas.controladores.ReservaController">
    <stylesheets>
        <URL value="@/una/eif206/reservas/fxml/css/estilos.css"/>
    </stylesheets>
    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnReservaVolver" text="← VOLVER AL MENÚ PRINCIPAL" onAction="#onVolverPrincipal" styleClass="btn-outline-info" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="15.0" styleClass="panel" style="-fx-border-color: #00A8FF; -fx-border-width: 1.2; -fx-border-radius: 10;">
        <Label text="◇  ASISTENTE INTELIGENTE IA" styleClass="label-title" style="-fx-font-size: 16px;"/>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Label text="FRASE" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtReservaFrase" promptText="Describa el propósito..." prefHeight="38.0" prefWidth="520.0"/>
            <Button fx:id="btnReservaExtraerIA" text="EXTRAER (IA) ✦" prefHeight="38.0" prefWidth="140.0" onAction="#onExtraerIA" styleClass="btn-ai" style="-fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <VBox spacing="15.0" styleClass="panel" style="-fx-border-color: #00A8FF; -fx-border-width: 1.2; -fx-border-radius: 10;">
        <Label text="◇  NUEVA RESERVA" styleClass="label-title" style="-fx-font-size: 16px;"/>
        <HBox spacing="30.0">
            <GridPane hgap="15.0" vgap="12.0" HBox.hgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="130.0" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="220.0"/>
                </columnConstraints>
                <Label text="ACTIVIDAD" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtReservaActividad" prefHeight="38.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="FECHA" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="dpReservaFecha" prefHeight="38.0" prefWidth="220.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="INICIO (HH:mm)" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtReservaHoraInicio" promptText="00:00" prefHeight="38.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="FIN (HH:mm)" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtReservaHoraFin" promptText="00:00" prefHeight="38.0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label text="CATEGORÍAS REQUERIDAS" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
                <ListView fx:id="lstReservaCategorias" prefHeight="150.0" styleClass="list-view"/>
            </VBox>
        </HBox>
        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <Button fx:id="btnReservaReservar" text="REGISTRAR" prefHeight="40.0" prefWidth="130.0" onAction="#onReservar" styleClass="btn-primary" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnReservaCancelarSeleccionada" text="CANCELAR SELECCIONADA" prefHeight="40.0" prefWidth="210.0" onAction="#onCancelarSeleccionada" styleClass="btn-outline-danger"/>
            <Button fx:id="btnReservaLimpiar" text="LIMPIAR" prefHeight="40.0" prefWidth="110.0" onAction="#onLimpiar" styleClass="btn-outline-info"/>
        </HBox>
        <Label fx:id="lblReservaError" styleClass="label-error"/>
    </VBox>

    <HBox alignment="BOTTOM_LEFT" spacing="15.0">
        <Label text="REGISTROS DE RESERVAS" styleClass="label-title" style="-fx-font-size: 14px;"/>
        <Button fx:id="btnReservaImprimir" text="IMPRIMIR" onAction="#onImprimir" styleClass="btn-outline-info" style="-fx-font-size: 11px; -fx-padding: 5 15;"/>
    </HBox>

    <TableView fx:id="tblReservaListado" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colReservaId" text="ID" prefWidth="100.0"/>
            <TableColumn fx:id="colReservaActividad" text="ACTIVIDAD" prefWidth="320.0"/>
            <TableColumn fx:id="colReservaFecha" text="FECHA" prefWidth="120.0"/>
            <TableColumn fx:id="colReservaHorario" text="HORARIO" prefWidth="160.0"/>
            <TableColumn fx:id="colReservaEstado" text="ESTADO" prefWidth="120.0"/>
        </columns>
    </TableView>
</VBox>