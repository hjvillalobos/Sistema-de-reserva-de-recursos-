<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox spacing="20.0" prefWidth="900.0" prefHeight="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.eif206.reservas.controlador.RecursoController">
    <stylesheets>
        <URL value="@/una/eif206/reservas/css/estilos.css"/>
    </stylesheets>
    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

    <VBox spacing="15.0" styleClass="panel">
        <Label text="Filtro de Búsqueda" styleClass="label-title"/>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Label text="Categoría" styleClass="label-subtitle"/>
            <ComboBox fx:id="cmbRecursoFiltroCategoria" promptText="Seleccione" prefWidth="180.0"/>
            <Label text="Descripción" styleClass="label-subtitle"/>
            <TextField fx:id="txtRecursoFiltroDescripcion" promptText="Descripción del recurso" prefWidth="200.0"/>
            <Button fx:id="btnRecursoBuscar" text="Buscar" onAction="#onBuscar" styleClass="btn-primary"/>
            <Button fx:id="btnRecursoImprimir" text="Imprimir" onAction="#onImprimir" styleClass="btn-outline-info"/>
            <Button fx:id="btnRecursoVolver" text="← Volver al Menú Principal" onAction="#onVolverPrincipal" styleClass="btn-outline-info"/>
        </HBox>
    </VBox>

    <VBox spacing="15.0" styleClass="panel">
        <Label text="Datos del Recurso" styleClass="label-title"/>
        <GridPane hgap="15.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints minWidth="80.0" halignment="RIGHT"/>
                <ColumnConstraints minWidth="250.0"/>
            </columnConstraints>
            <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-subtitle"/>
            <TextField fx:id="txtRecursoId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Categoría" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-subtitle"/>
            <ComboBox fx:id="cmbRecursoCategoria" promptText="Seleccione una categoría" prefWidth="250.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Descripción" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-subtitle"/>
            <TextField fx:id="txtRecursoDescripcion" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="10.0">
            <Button fx:id="btnRecursoGuardar" text="Guardar" onAction="#onGuardar" styleClass="btn-primary"/>
            <Button fx:id="btnRecursoBorrar" text="Borrar" onAction="#onBorrar" styleClass="btn-outline-danger"/>
            <Button fx:id="btnRecursoLimpiar" text="Limpiar" onAction="#onLimpiar" styleClass="btn-outline-info"/>
        </HBox>
        <Label fx:id="lblRecursoError" styleClass="label-error"/>
    </VBox>

    <Label text="Listado de Recursos" styleClass="label-title"/>
    <TableView fx:id="tblRecursoListado" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colRecursoId" text="ID" prefWidth="120.0"/>
            <TableColumn fx:id="colRecursoCategoria" text="Categoría" prefWidth="250.0"/>
            <TableColumn fx:id="colRecursoDescripcion" text="Descripción" prefWidth="400.0"/>
        </columns>
    </TableView>
</VBox>