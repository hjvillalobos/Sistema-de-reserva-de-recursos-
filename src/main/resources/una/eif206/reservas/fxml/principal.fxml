<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.eif206.reservas.controlador.PrincipalController">

    <stylesheets>
        <URL value="@/una/eif206/reservas/css/estilos.css" />
    </stylesheets>

    <VBox alignment="CENTER" spacing="35.0" VBox.vgrow="ALWAYS">
        <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

        <VBox alignment="CENTER" maxWidth="750.0" prefHeight="480.0" spacing="30.0" style="-fx-border-color: #00A8FF; -fx-border-width: 1.5; -fx-border-radius: 12;" styleClass="panel">
            <padding><Insets bottom="40" left="60" right="60" top="40" /></padding>

            <VBox alignment="CENTER" spacing="10.0">
                <Label fx:id="lblPrincipalBienvenida" alignment="CENTER" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #EAF6FF;" styleClass="label-title" text="INITIALIZING SYSTEM..." />
                <Label alignment="CENTER" style="-fx-font-size: 12px; -fx-letter-spacing: 3px; -fx-text-fill: #38BDF8;" styleClass="label-subtitle" />
            </VBox>

            <VBox alignment="CENTER" prefWidth="350.0" spacing="18.0">
                <Button fx:id="btnPrincipalCategorias" managed="false" onAction="#onAbrirCategorias" prefHeight="48.0" prefWidth="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="btn-outline-info" text="GESTIONAR CATEGORÍAS" visible="false" />
                <Button fx:id="btnPrincipalFuncionarios" managed="false" onAction="#onAbrirFuncionarios" prefHeight="48.0" prefWidth="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="btn-outline-info" text="GESTIONAR FUNCIONARIOS" visible="false" />
                <Button fx:id="btnPrincipalRecursos" managed="false" onAction="#onAbrirRecursos" prefHeight="48.0" prefWidth="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="btn-outline-info" text="GESTIONAR RECURSOS" visible="false" />
                <Button fx:id="btnPrincipalReservas" managed="false" onAction="#onAbrirReservas" prefHeight="48.0" prefWidth="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="btn-primary" text="ACCEDER A MIS RESERVAS" visible="false" />

                <Button fx:id="btnPrincipalCerrarSesion" onAction="#onCerrarSesion" prefHeight="48.0" prefWidth="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="btn-outline-danger" text="CERRAR SESIÓN" />
            </VBox>

            <Label style="-fx-text-fill: #38BDF8; -fx-font-size: 15px; -fx-font-weight: bold; -fx-opacity: 0.8;" text="●  CONFIANOS TUS RESERVAS " />
        </VBox>
    </VBox>
</VBox>
