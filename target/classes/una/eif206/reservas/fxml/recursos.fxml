<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" prefWidth="950.0" prefHeight="750.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.eif206.reservas.controladores.RecursoController">
    <stylesheets>
        <URL value="@/una/eif206/reservas/fxml/css/estilos.css"/>
    </stylesheets>
    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnRecursoVolver" text="← VOLVER AL MENÚ PRINCIPAL" onAction="#onVolverPrincipal" styleClass="btn-outline-info" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="15.0" styleClass="panel" style="-fx-border-color: #00A8FF; -fx-border-width: 1.2; -fx-border-radius: 10;">
        <Label text="◇  FILTRO DE BÚSQUEDA" styleClass="label-title" style="-fx-font-size: 16px;"/>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Label text="CATEGORÍA" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbRecursoFiltroCategoria" promptText="Seleccione" prefHeight="38.0" prefWidth="180.0"/>
            <Label text="DESCRIPCIÓN" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtRecursoFiltroDescripcion" promptText="Buscar recurso..." prefHeight="38.0" prefWidth="200.0"/>
            <Button fx:id="btnRecursoBuscar" text="BUSCAR" prefHeight="38.0" prefWidth="100.0" onAction="#onBuscar" styleClass="btn-primary" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnRecursoImprimir" text="IMPRIMIR" prefHeight="38.0" prefWidth="100.0" onAction="#onImprimir" styleClass="btn-outline-info"/>
        </HBox>
    </VBox>

    <VBox spacing="15.0" styleClass="panel" style="-fx-border-color: #00A8FF; -fx-border-width: 1.2; -fx-border-radius: 10;">
        <Label text="◇  REGISTRO DE RECURSO" styleClass="label-title" style="-fx-font-size: 16px;"/>
        <GridPane hgap="15.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints minWidth="100.0" halignment="RIGHT"/>
                <ColumnConstraints minWidth="280.0"/>
            </columnConstraints>
            <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtRecursoId" prefHeight="38.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="CATEGORÍA" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbRecursoCategoria" promptText="Seleccione una categoría" prefHeight="38.0" prefWidth="280.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="DESCRIPCIÓN" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtRecursoDescripcion" prefHeight="38.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="12.0">
            <Button fx:id="btnRecursoGuardar" text="GUARDAR" prefHeight="40.0" prefWidth="110.0" onAction="#onGuardar" styleClass="btn-primary" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnRecursoBorrar" text="ELIMINAR" prefHeight="40.0" prefWidth="110.0" onAction="#onBorrar" styleClass="btn-outline-danger"/>
            <Button fx:id="btnRecursoLimpiar" text="LIMPIAR" prefHeight="40.0" prefWidth="110.0" onAction="#onLimpiar" styleClass="btn-outline-info"/>
        </HBox>
        <Label fx:id="lblRecursoError" styleClass="label-error"/>
    </VBox>

    <Label text="REGISTROS ACTIVOS" styleClass="label-title" style="-fx-font-size: 14px;"/>
    <TableView fx:id="tblRecursoListado" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colRecursoId" text="ID" prefWidth="120.0"/>
            <TableColumn fx:id="colRecursoCategoria" text="CATEGORÍA" prefWidth="250.0"/>
            <TableColumn fx:id="colRecursoDescripcion" text="DESCRIPCIÓN" prefWidth="400.0"/>
        </columns>
    </TableView>
</VBox>