<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" prefWidth="950.0" prefHeight="750.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.eif206.reservas.controlador.FuncionarioController">
    <stylesheets>
        <URL value="@/una/eif206/reservas/css/estilos.css"/>
    </stylesheets>
    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnFuncionarioVolver" text="← VOLVER AL MENÚ PRINCIPAL" onAction="#onVolverPrincipal" styleClass="btn-outline-info" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="15.0" styleClass="panel" style="-fx-border-color: #00A8FF; -fx-border-width: 1.2; -fx-border-radius: 10;">
        <Label text="◇  BÚSQUEDA DE FUNCIONARIOS" styleClass="label-title" style="-fx-font-size: 16px;"/>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Label text="ID" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtFuncionarioBusquedaId" promptText="ID" prefHeight="38.0" prefWidth="110.0"/>
            <Label text="NOMBRE" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtFuncionarioBusquedaNombre" promptText="Nombre..." prefHeight="38.0" prefWidth="220.0"/>
            <Button fx:id="btnFuncionarioBuscar" text="BUSCAR" prefHeight="38.0" prefWidth="100.0" onAction="#onBuscar" styleClass="btn-primary" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnFuncionarioImprimir" text="IMPRIMIR" prefHeight="38.0" prefWidth="100.0" onAction="#onImprimir" styleClass="btn-outline-info"/>
        </HBox>
    </VBox>

    <VBox spacing="15.0" styleClass="panel" style="-fx-border-color: #00A8FF; -fx-border-width: 1.2; -fx-border-radius: 10;">
        <Label text="◇  REGISTRO DE FUNCIONARIO" styleClass="label-title" style="-fx-font-size: 16px;"/>
        <GridPane hgap="15.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints minWidth="100.0" halignment="RIGHT"/>
                <ColumnConstraints minWidth="280.0"/>
            </columnConstraints>
            <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtFuncionarioId" prefHeight="38.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="NOMBRE" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtFuncionarioNombre" prefHeight="38.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="TELÉFONO" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-subtitle" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtFuncionarioTelefono" prefHeight="38.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="12.0">
            <Button fx:id="btnFuncionarioGuardar" text="GUARDAR" prefHeight="40.0" prefWidth="110.0" onAction="#onGuardar" styleClass="btn-primary" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnFuncionarioBorrar" text="ELIMINAR" prefHeight="40.0" prefWidth="110.0" onAction="#onBorrar" styleClass="btn-outline-danger"/>
            <Button fx:id="btnFuncionarioLimpiar" text="LIMPIAR" prefHeight="40.0" prefWidth="110.0" onAction="#onLimpiar" styleClass="btn-outline-info"/>
        </HBox>
        <Label fx:id="lblFuncionarioError" styleClass="label-error"/>
    </VBox>

    <Label text="REGISTROS ACTIVOS" styleClass="label-title" style="-fx-font-size: 14px;"/>
    <TableView fx:id="tblFuncionarioListado" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFuncionarioId" text="ID" prefWidth="120.0"/>
            <TableColumn fx:id="colFuncionarioNombre" text="NOMBRE" prefWidth="320.0"/>
            <TableColumn fx:id="colFuncionarioTelefono" text="TELÉFONO" prefWidth="160.0"/>
        </columns>
    </TableView>
</VBox>